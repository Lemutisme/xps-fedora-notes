+/**
+ * Bucket-level confirmation for automatic brightness.
+ *
+ * The ambient light sensor on this machine produces a usable reading only
+ * some of the time, and the readings that do arrive drift rather than step.
+ * Confirming a change therefore has to happen over a sustained period and in
+ * discrete bucket space, not on individual lux samples:
+ *
+ *  - In bucket space, a smoothly decaying source (a torch being moved away)
+ *    stays inside one bucket, so it counts as one sustained intent instead of
+ *    restarting the clock on every sample.
+ *  - Darkening is confirmed quickly, because a dark room must not be left
+ *    glaring; brightening is confirmed slowly, because a false bright reading
+ *    is the one that actually hurts.
+ *  - A cooldown keeps two adjacent buckets from oscillating against each other.
+ *
+ * This class is deliberately free of GNOME and GObject imports so the policy
+ * can be exercised directly.
+ */
+export class BrightnessConfirm {
+  constructor({
+    darkenMs = 2500,
+    brightenMs = 8000,
+    cooldownMs = 15000,
+    now = () => Date.now(),
+  } = {}) {
+    this._darkenMs = darkenMs;
+    this._brightenMs = brightenMs;
+    this._cooldownMs = cooldownMs;
+    this._now = now;
+
+    this._candidate = null;
+    this._candidateSince = 0;
+    // No cooldown before the very first change.
+    this._committedAt = -Infinity;
+  }
+
+  /**
+   * Offer the bucket the mapper currently points at.
+   *
+   * @param {number} bucketIndex - Target bucket index
+   * @param {number} appliedIndex - Bucket index currently on screen, or -1
+   * @param {boolean} darkening - True when the target is dimmer
+   * @returns {boolean} True once the target has been sustained long enough
+   */
+  offer(bucketIndex, appliedIndex, darkening) {
+    if (bucketIndex === appliedIndex) {
+      // Back where we started: abandon any pending change.
+      this._candidate = null;
+      return false;
+    }
+
+    const t = this._now();
+
+    if (this._candidate !== bucketIndex) {
+      this._candidate = bucketIndex;
+      this._candidateSince = t;
+    }
+
+    const need = darkening ? this._darkenMs : this._brightenMs;
+    if (t - this._candidateSince < need) {
+      return false;
+    }
+
+    if (t - this._committedAt < this._cooldownMs) {
+      return false;
+    }
+
+    this._candidate = null;
+    this._committedAt = t;
+    return true;
+  }
+
+  /** Forget the pending candidate, e.g. on resume or when settings change. */
+  reset() {
+    this._candidate = null;
+    this._candidateSince = 0;
+  }
+}
